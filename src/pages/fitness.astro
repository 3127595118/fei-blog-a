---
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const stats = [
	{ label: "身高", value: "176 cm" },
	{ label: "体重", value: "65 kg" },
	{ label: "年龄", value: "20 岁" },
	{ label: "BMI", value: "21.0" },
	{ label: "目标", value: "腰围 ↓ / 肩背 ↑" },
];
---

<MainGridLayout title="薄肌训练计划" description="我的薄肌训练计划与每日打卡：176cm / 65kg / 20 岁，晚上下班后在家练，身体重组路线。">
	<div class="flex flex-col gap-4 w-full">
		<!-- 个人数据 -->
		<div class="card-base px-6 py-6">
			<div class="flex items-center gap-3 mb-4">
				<span class="text-2xl font-bold text-90">我的训练档案</span>
				<span class="text-xs px-2 py-1 rounded-full bg-(--primary)/10 text-(--primary)">第 1 周</span>
			</div>
			<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
				{stats.map((s) => (
					<div class="rounded-xl bg-(--btn-regular-bg)/60 px-3 py-3">
						<div class="text-xs text-30 mb-1">{s.label}</div>
						<div class="text-base font-bold text-90">{s.value}</div>
					</div>
				))}
			</div>
			<p class="text-sm text-50 mt-4 leading-relaxed">
				176cm / 65kg，但<strong class="text-90">肚子有肉、腿部偏粗、肩背偏薄</strong>，属于典型的「瘦胖子」。所以不走狂吃增肌路线，而是<strong class="text-90">身体重组</strong>：体重控制在 64–66kg 基本不变，腰围往下走，肩背和手臂往上长。周期 12 周，每 4 周量一次腰围做评估。
			</p>
		</div>

		<!-- 今日训练 -->
		<div class="card-base px-6 py-6">
			<div class="flex items-center justify-between mb-4">
				<div>
					<div class="text-lg font-bold text-90" id="today-title">今日训练</div>
					<div class="text-xs text-30 mt-1" id="today-date"></div>
				</div>
				<span class="text-xs px-3 py-1.5 rounded-full bg-(--primary)/10 text-(--primary) font-medium" id="today-type">—</span>
			</div>
			<ul class="flex flex-col gap-2" id="today-list"></ul>
			<p class="text-xs text-30 mt-4">点动作可打勾记录完成情况。组间休息 60–90 秒，每个动作留 1–2 次余力。</p>
		</div>

		<!-- 本周打卡 -->
		<div class="card-base px-6 py-6">
			<div class="flex items-center justify-between mb-3">
				<span class="text-lg font-bold text-90">本周打卡</span>
				<span class="text-sm text-30" id="week-count">0 / 3</span>
			</div>
			<div class="grid grid-cols-7 gap-2" id="week-grid"></div>
			<div class="flex items-center gap-4 mt-4 text-xs text-30">
				<span class="flex items-center gap-1.5"><i class="w-2.5 h-2.5 rounded-full bg-(--primary) inline-block"></i>已完成</span>
				<span class="flex items-center gap-1.5"><i class="w-2.5 h-2.5 rounded-full bg-(--btn-regular-bg) inline-block"></i>未完成</span>
				<button type="button" id="reset-week" class="ml-auto text-(--primary) hover:underline">重置本周</button>
			</div>
		</div>

		<!-- 作息时间表 -->
		<div class="card-base px-6 py-6">
			<div class="text-lg font-bold text-90 mb-1">工作日时间表</div>
			<p class="text-xs text-30 mb-4">早上 7:30 上班，训练全部放在下班后，别熬夜练。</p>
			<div class="flex flex-col gap-1.5">
				{[
					["06:50", "早餐：2 个蛋 + 燕麦 + 牛奶（约 500 kcal）"],
					["07:30", "上班"],
					["12:00", "午餐：一掌心肉 + 一拳主食 + 两拳蔬菜"],
					["18:00", "下班"],
					["18:40", "到家先加餐：香蕉 + 无糖酸奶"],
					["19:10", "训练 40 分钟（练前热身 5 分钟）"],
					["20:00", "晚饭：优质蛋白 + 少量主食 + 大量蔬菜"],
					["22:30", "上床，保证 7–8 小时睡眠"],
				].map(([time, text]) => (
					<div class="flex gap-3 text-sm">
						<span class="w-14 shrink-0 text-(--primary) font-medium tabular-nums">{time}</span>
						<span class="text-50">{text}</span>
					</div>
				))}
			</div>
		</div>

		<!-- 训练记录 -->
		<div class="card-base px-6 py-6">
			<div class="text-lg font-bold text-90 mb-1">训练记录</div>
			<p class="text-xs text-30 mb-4">记录主要动作的重量和次数，下次照着上次的数据加一点。</p>
			<form id="log-form" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2 mb-4">
				<input type="date" id="log-date" class="col-span-2 sm:col-span-1 rounded-lg bg-(--btn-regular-bg) px-3 py-2 text-sm text-90 outline-none focus:ring-2 focus:ring-(--primary)/40" required />
				<select id="log-exercise" class="col-span-2 sm:col-span-1 rounded-lg bg-(--btn-regular-bg) px-3 py-2 text-sm text-90 outline-none focus:ring-2 focus:ring-(--primary)/40" required>
					<option value="">选择动作</option>
				</select>
				<input type="number" id="log-weight" step="0.5" min="0" placeholder="重量 kg" class="rounded-lg bg-(--btn-regular-bg) px-3 py-2 text-sm text-90 outline-none focus:ring-2 focus:ring-(--primary)/40" />
				<input type="number" id="log-sets" min="1" max="20" placeholder="组数" class="rounded-lg bg-(--btn-regular-bg) px-3 py-2 text-sm text-90 outline-none focus:ring-2 focus:ring-(--primary)/40" />
				<input type="number" id="log-reps" min="1" max="100" placeholder="次数" class="rounded-lg bg-(--btn-regular-bg) px-3 py-2 text-sm text-90 outline-none focus:ring-2 focus:ring-(--primary)/40" />
				<button type="submit" class="rounded-lg bg-(--primary) text-white text-sm font-medium px-3 py-2 hover:opacity-90 transition-opacity">添加</button>
			</form>
			<div class="overflow-x-auto">
				<table class="w-full text-sm">
					<thead>
						<tr class="text-30 text-xs border-b border-(--btn-regular-bg)">
							<th class="text-left py-2 font-normal">日期</th>
							<th class="text-left py-2 font-normal">动作</th>
							<th class="text-left py-2 font-normal">重量</th>
							<th class="text-left py-2 font-normal">组×次</th>
							<th class="py-2"></th>
						</tr>
					</thead>
					<tbody id="log-body"></tbody>
				</table>
			</div>
			<div class="flex items-center gap-4 mt-3">
				<button type="button" id="export-csv" class="text-xs text-(--primary) hover:underline">导出 CSV</button>
				<button type="button" id="clear-logs" class="text-xs text-30 hover:text-red-400">清空记录</button>
				<span class="text-xs text-30 ml-auto" id="log-count"></span>
			</div>
		</div>

		<!-- 体重 & 腰围 -->
		<div class="card-base px-6 py-6">
			<div class="text-lg font-bold text-90 mb-1">体重 & 腰围</div>
			<p class="text-xs text-30 mb-4">每周固定同一天早起排空后称重、量腰围（肚脐水平），看 4 周趋势。</p>
			<form id="weight-form" class="flex flex-wrap gap-2 mb-4">
				<input type="date" id="weight-date" class="rounded-lg bg-(--btn-regular-bg) px-3 py-2 text-sm text-90 outline-none focus:ring-2 focus:ring-(--primary)/40" required />
				<input type="number" id="weight-value" step="0.1" min="30" max="200" placeholder="体重 kg" class="rounded-lg bg-(--btn-regular-bg) px-3 py-2 text-sm text-90 outline-none focus:ring-2 focus:ring-(--primary)/40" required />
				<input type="number" id="waist-value" step="0.1" min="40" max="150" placeholder="腰围 cm" class="rounded-lg bg-(--btn-regular-bg) px-3 py-2 text-sm text-90 outline-none focus:ring-2 focus:ring-(--primary)/40" />
				<button type="submit" class="rounded-lg bg-(--primary) text-white text-sm font-medium px-4 py-2 hover:opacity-90 transition-opacity">记录</button>
			</form>
			<div class="flex items-end gap-6 mb-4">
				<div>
					<div class="text-xs text-30">当前体重</div>
					<div class="text-2xl font-bold text-90" id="weight-now">—</div>
				</div>
				<div>
					<div class="text-xs text-30">当前腰围</div>
					<div class="text-2xl font-bold text-90" id="waist-now">—</div>
				</div>
				<div>
					<div class="text-xs text-30">腰围变化</div>
					<div class="text-2xl font-bold text-(--primary)" id="waist-delta">—</div>
				</div>
			</div>
			<div id="weight-chart" class="flex items-end gap-1 h-24 mb-3"></div>
			<div id="weight-list" class="flex flex-col gap-1 text-sm"></div>
		</div>

		<!-- 计划说明 -->
		<div class="card-base px-6 py-6">
			<div class="text-lg font-bold text-90 mb-3">12 周计划说明</div>
			<div class="grid grid-cols-1 md:grid-cols-2 gap-5 text-sm text-50 leading-relaxed">
				<div>
					<div class="font-bold text-90 mb-1">为什么是一周 3 练</div>
					<ul class="list-disc pl-5 space-y-1">
						<li>下班后训练，精力有限，3 次全身比 4 次分化更容易坚持</li>
						<li>每次 5 个动作、40 分钟，19:10 开始 19:50 结束</li>
						<li>周一 / 周三 / 周五力量，周二 / 周六快走 25 分钟</li>
						<li>周四、周日完全休息，保证恢复</li>
					</ul>
				</div>
				<div>
					<div class="font-bold text-90 mb-1">吃法（约 2050 kcal）</div>
					<ul class="list-disc pl-5 space-y-1">
						<li>蛋白质 130g（约 2g/kg），每餐 30–35g</li>
						<li>脂肪 55g，碳水 210g 左右</li>
						<li>体重维持 64–66kg，腰围每 4 周 -1cm 算达标</li>
						<li>戒掉奶茶、含糖饮料和夜宵，这一条比任何训练都有效</li>
					</ul>
				</div>
				<div>
					<div class="font-bold text-90 mb-1">肚子上的肉</div>
					<p>没法局部减。靠两件事：整体热量轻微缺口 + 每周 2 次有氧。腹肌训练只是让腹部更紧实，露不露得看体脂，别做几百个卷腹自我安慰。</p>
				</div>
				<div>
					<div class="font-bold text-90 mb-1">腿粗怎么办</div>
					<p>腿上的「肉」多半是脂肪，先把整体体脂降下来。腿部训练不能停，但重点放在<strong class="text-90">单腿动作和臀部</strong>（分腿蹲、臀桥、罗马尼亚硬拉），少做大重量高次数深蹲。</p>
				</div>
			</div>
			<p class="text-xs text-30 mt-4">
				相关文章：
				<a class="text-(--primary) hover:underline" href="/posts/thin-muscle-start/">入门</a> ·
				<a class="text-(--primary) hover:underline" href="/posts/thin-muscle-plan/">四练计划</a> ·
				<a class="text-(--primary) hover:underline" href="/posts/thin-muscle-moves/">动作库</a> ·
				<a class="text-(--primary) hover:underline" href="/posts/thin-muscle-diet/">饮食</a> ·
				<a class="text-(--primary) hover:underline" href="/posts/thin-muscle-faq/">常见问题</a>
			</p>
		</div>
	</div>

	<script is:inline>
		(function () {
			var KEY = "fei-fitness-v1";
			var PLAN = {
				1: { type: "力量 A", name: "全身 A · 推 + 蹲", items: [["哑铃卧推", "4 × 8–12"], ["高脚杯深蹲", "4 × 10–12"], ["坐姿哑铃肩推", "3 × 8–12"], ["保加利亚分腿蹲", "3 × 8–10 / 侧"], ["死虫", "3 × 10 / 侧"]] },
				2: { type: "有氧", name: "有氧日 · 快走", items: [["快走（能说话的速度）", "25 分钟"], ["全身拉伸", "10 分钟"], ["泡沫轴放松大腿前侧", "5 分钟"]] },
				3: { type: "力量 B", name: "全身 B · 拉 + 髋", items: [["引体向上 / 弹力带辅助", "4 × 6–10"], ["哑铃罗马尼亚硬拉", "4 × 10–12"], ["单臂哑铃划船", "3 × 10–12 / 侧"], ["俯身反向飞鸟", "3 × 12–15"], ["侧平板", "3 × 30 秒 / 侧"]] },
				4: { type: "休息", name: "完全休息", items: [["睡够 7–8 小时", "—"], ["散步 20 分钟（可选）", "—"]] },
				5: { type: "力量 C", name: "全身 C · 混合 + 核心", items: [["哑铃硬拉", "4 × 8"], ["哑铃弓箭步走", "3 × 12 / 侧"], ["俯卧撑", "3 × 力竭前 2"], ["哑铃弯举", "3 × 10–12"], ["农夫行走", "3 × 40 秒"]] },
				6: { type: "有氧", name: "有氧日 · 轻活动", items: [["快走 / 骑车", "25 分钟"], ["平板支撑", "3 × 45 秒"]] },
				0: { type: "休息", name: "完全休息", items: [["睡够 8 小时", "—"], ["提前备好下周的早餐", "—"]] },
			};
			var DAY_NAMES = ["周日", "周一", "周二", "周三", "周四", "周五", "周六"];
			var TRAINING_TYPES = ["力量 A", "力量 B", "力量 C", "有氧"];
			var EXERCISES = [
				"哑铃卧推", "上斜哑铃卧推", "坐姿哑铃肩推", "侧平举", "窄距俯卧撑", "双杠臂屈伸",
				"引体向上", "单臂哑铃划船", "俯身反向飞鸟", "哑铃弯举",
				"高脚杯深蹲", "保加利亚分腿蹲", "哑铃罗马尼亚硬拉", "臀桥", "站姿提踵",
				"哑铃硬拉", "哑铃弓箭步走", "俯卧撑", "死虫", "侧平板", "农夫行走", "平板支撑",
				"快走 / 慢跑",
			];

			function load() {
				try {
					var d = JSON.parse(localStorage.getItem(KEY) || "{}");
					return {
						checks: d.checks || {},
						items: d.items || {},
						logs: d.logs || [],
						weights: d.weights || [],
					};
				} catch (e) {
					return { checks: {}, items: {}, logs: [], weights: [] };
				}
			}
			function save(s) {
				localStorage.setItem(KEY, JSON.stringify(s));
			}
			function iso(d) {
				var m = d.getMonth() + 1, day = d.getDate();
				return d.getFullYear() + "-" + (m < 10 ? "0" : "") + m + "-" + (day < 10 ? "0" : "") + day;
			}
			function esc(s) {
				return String(s).replace(/[&<>"]/g, function (c) {
					return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c];
				});
			}
			function weekDates() {
				var now = new Date();
				var dow = now.getDay() === 0 ? 7 : now.getDay();
				var monday = new Date(now);
				monday.setDate(now.getDate() - (dow - 1));
				var arr = [];
				for (var i = 0; i < 7; i++) {
					var d = new Date(monday);
					d.setDate(monday.getDate() + i);
					arr.push(d);
				}
				return arr;
			}

			function renderToday(state) {
				var now = new Date();
				var plan = PLAN[now.getDay()];
				var title = document.getElementById("today-title");
				var dateEl = document.getElementById("today-date");
				var typeEl = document.getElementById("today-type");
				var list = document.getElementById("today-list");
				if (!title || !list) return;
				title.textContent = plan.name;
				dateEl.textContent = iso(now) + " " + DAY_NAMES[now.getDay()];
				typeEl.textContent = plan.type;

				var mapKey = iso(now);
				var done = state.items[mapKey] || {};
				list.innerHTML = plan.items
					.map(function (it, i) {
						var checked = !!done[i];
						return (
							'<li><button type="button" data-idx="' + i + '" class="w-full flex items-center justify-between rounded-lg px-3 py-2 transition-colors ' +
							(checked ? "bg-(--primary)/15" : "bg-(--btn-regular-bg)/50 hover:bg-(--btn-regular-bg)") + '">' +
							'<span class="flex items-center gap-2 text-sm ' + (checked ? "text-50 line-through" : "text-90") + '">' +
							'<span class="w-4 h-4 rounded border inline-flex items-center justify-center text-[10px] ' +
							(checked ? "bg-(--primary) border-(--primary) text-white" : "border-(--btn-regular-bg) text-transparent") + '">✓</span>' +
							esc(it[0]) + "</span>" +
							'<span class="text-xs text-30">' + esc(it[1]) + "</span></button></li>"
						);
					})
					.join("");

				list.querySelectorAll("[data-idx]").forEach(function (btn) {
					btn.addEventListener("click", function () {
						var s = load();
						var k = iso(new Date());
						var idx = btn.getAttribute("data-idx");
						s.items[k] = s.items[k] || {};
						if (s.items[k][idx]) delete s.items[k][idx];
						else s.items[k][idx] = true;
						save(s);
						renderToday(s);
					});
				});
			}

			function renderWeek(state) {
				var grid = document.getElementById("week-grid");
				if (!grid) return;
				var days = weekDates();
				var done = 0;
				var total = 0;
				grid.innerHTML = days
					.map(function (d) {
						var key = iso(d);
						var plan = PLAN[d.getDay()];
						var isTraining = TRAINING_TYPES.indexOf(plan.type) >= 0;
						if (isTraining) total++;
						var checked = !!state.checks[key];
						if (checked && isTraining) done++;
						return (
							'<button type="button" data-date="' + key + '" class="flex flex-col items-center gap-1 rounded-xl px-1 py-2 transition-colors ' +
							(checked ? "bg-(--primary) text-white" : "bg-(--btn-regular-bg) text-50 hover:opacity-80") + '">' +
							'<span class="text-[10px] opacity-80">' + DAY_NAMES[d.getDay()].slice(1) + "</span>" +
							'<span class="text-sm font-bold">' + d.getDate() + "</span>" +
							'<span class="text-[10px] opacity-80">' + plan.type.replace("力量 ", "") + "</span></button>"
						);
					})
					.join("");
				var count = document.getElementById("week-count");
				if (count) count.textContent = done + " / " + total;
				grid.querySelectorAll("[data-date]").forEach(function (btn) {
					btn.addEventListener("click", function () {
						var s = load();
						var k = btn.getAttribute("data-date");
						if (s.checks[k]) delete s.checks[k];
						else s.checks[k] = true;
						save(s);
						renderWeek(s);
					});
				});
			}

			function renderLogs(state) {
				var body = document.getElementById("log-body");
				var countEl = document.getElementById("log-count");
				if (!body) return;
				var logs = state.logs.slice().sort(function (a, b) {
					if (a.date !== b.date) return a.date < b.date ? 1 : -1;
					return b.id - a.id;
				});
				if (!logs.length) {
					body.innerHTML = '<tr><td colspan="5" class="py-6 text-center text-xs text-30">还没有记录，练完一组就记一条</td></tr>';
				} else {
					body.innerHTML = logs
						.map(function (l) {
							return (
								'<tr class="border-b border-(--btn-regular-bg) text-70">' +
								'<td class="py-2 text-xs">' + esc(l.date) + "</td>" +
								'<td class="py-2 text-sm text-90">' + esc(l.exercise) + "</td>" +
								'<td class="py-2 text-sm">' + (l.weight ? esc(l.weight) + " kg" : "—") + "</td>" +
								'<td class="py-2 text-sm">' + (l.sets ? esc(l.sets) : "—") + " × " + (l.reps ? esc(l.reps) : "—") + "</td>" +
								'<td class="py-2 text-right"><button type="button" data-del="' + l.id + '" class="text-xs text-30 hover:text-red-400">删除</button></td></tr>'
							);
						})
						.join("");
				}
				if (countEl) countEl.textContent = "共 " + logs.length + " 条";
				body.querySelectorAll("[data-del]").forEach(function (btn) {
					btn.addEventListener("click", function () {
						var s = load();
						var id = btn.getAttribute("data-del");
						s.logs = s.logs.filter(function (l) {
							return String(l.id) !== id;
						});
						save(s);
						renderLogs(s);
					});
				});
			}

			function renderWeights(state) {
				var list = document.getElementById("weight-list");
				var chart = document.getElementById("weight-chart");
				var nowEl = document.getElementById("weight-now");
				var waistEl = document.getElementById("waist-now");
				var deltaEl = document.getElementById("waist-delta");
				if (!list) return;
				var ws = state.weights.slice().sort(function (a, b) {
					return a.date < b.date ? -1 : 1;
				});
				if (!ws.length) {
					list.innerHTML = '<div class="text-xs text-30">还没有记录</div>';
					if (chart) chart.innerHTML = "";
					if (nowEl) nowEl.textContent = "—";
					if (waistEl) waistEl.textContent = "—";
					if (deltaEl) deltaEl.textContent = "—";
					return;
				}
				var last = ws[ws.length - 1];
				var withWaist = ws.filter(function (w) {
					return w.waist;
				});
				if (nowEl) nowEl.textContent = last.kg.toFixed(1) + " kg";
				if (waistEl) waistEl.textContent = last.waist ? last.waist.toFixed(1) + " cm" : "—";
				if (deltaEl) {
					if (withWaist.length >= 2) {
						var d = withWaist[withWaist.length - 1].waist - withWaist[0].waist;
						deltaEl.textContent = (d >= 0 ? "+" : "") + d.toFixed(1) + " cm";
					} else {
						deltaEl.textContent = "—";
					}
				}
				var vals = ws.map(function (w) {
					return w.kg;
				});
				var min = Math.min.apply(null, vals);
				var max = Math.max.apply(null, vals);
				var span = Math.max(max - min, 0.5);
				if (chart) {
					chart.innerHTML = ws
						.slice(-20)
						.map(function (w) {
							var h = 20 + ((w.kg - min) / span) * 80;
							return '<div class="flex-1 rounded-t bg-(--primary)/70 transition-all" style="height:' + h + '%" title="' + w.date + " " + w.kg + 'kg"></div>';
						})
						.join("");
				}
				list.innerHTML = ws
					.slice(-10)
					.reverse()
					.map(function (w) {
						return (
							'<div class="flex items-center justify-between border-b border-(--btn-regular-bg) py-1">' +
							'<span class="text-xs text-30">' + esc(w.date) + "</span>" +
							'<span class="text-sm text-90">' + w.kg.toFixed(1) + " kg" + (w.waist ? " · 腰围 " + w.waist.toFixed(1) + " cm" : "") + "</span></div>"
						);
					})
					.join("");
			}

			function init() {
				var state = load();
				renderToday(state);
				renderWeek(state);
				renderLogs(state);
				renderWeights(state);

				var sel = document.getElementById("log-exercise");
				if (sel && sel.options.length <= 1) {
					EXERCISES.forEach(function (name) {
						var o = document.createElement("option");
						o.value = name;
						o.textContent = name;
						sel.appendChild(o);
					});
				}
				var dateInput = document.getElementById("log-date");
				if (dateInput && !dateInput.value) dateInput.value = iso(new Date());
				var wDate = document.getElementById("weight-date");
				if (wDate && !wDate.value) wDate.value = iso(new Date());

				var form = document.getElementById("log-form");
				if (form && !form.dataset.bound) {
					form.dataset.bound = "1";
					form.addEventListener("submit", function (e) {
						e.preventDefault();
						var s = load();
						s.logs.push({
							id: Date.now(),
							date: document.getElementById("log-date").value,
							exercise: document.getElementById("log-exercise").value,
							weight: document.getElementById("log-weight").value,
							sets: document.getElementById("log-sets").value,
							reps: document.getElementById("log-reps").value,
						});
						save(s);
						document.getElementById("log-weight").value = "";
						document.getElementById("log-sets").value = "";
						document.getElementById("log-reps").value = "";
						renderLogs(s);
					});
				}

				var wForm = document.getElementById("weight-form");
				if (wForm && !wForm.dataset.bound) {
					wForm.dataset.bound = "1";
					wForm.addEventListener("submit", function (e) {
						e.preventDefault();
						var s = load();
						var date = document.getElementById("weight-date").value;
						var kg = parseFloat(document.getElementById("weight-value").value);
						var waist = parseFloat(document.getElementById("waist-value").value);
						if (!date || !kg) return;
						s.weights = s.weights.filter(function (w) {
							return w.date !== date;
						});
						s.weights.push({ date: date, kg: kg, waist: isNaN(waist) ? null : waist });
						save(s);
						document.getElementById("weight-value").value = "";
						document.getElementById("waist-value").value = "";
						renderWeights(s);
					});
				}

				var reset = document.getElementById("reset-week");
				if (reset && !reset.dataset.bound) {
					reset.dataset.bound = "1";
					reset.addEventListener("click", function () {
						if (!confirm("清空本周打卡？")) return;
						var s = load();
						weekDates().forEach(function (d) {
							delete s.checks[iso(d)];
						});
						save(s);
						renderWeek(s);
					});
				}

				var clear = document.getElementById("clear-logs");
				if (clear && !clear.dataset.bound) {
					clear.dataset.bound = "1";
					clear.addEventListener("click", function () {
						if (!confirm("清空所有训练记录？")) return;
						var s = load();
						s.logs = [];
						save(s);
						renderLogs(s);
					});
				}

				var exp = document.getElementById("export-csv");
				if (exp && !exp.dataset.bound) {
					exp.dataset.bound = "1";
					exp.addEventListener("click", function () {
						var s = load();
						var rows = [["日期", "动作", "重量kg", "组数", "次数"]];
						s.logs.forEach(function (l) {
							rows.push([l.date, l.exercise, l.weight, l.sets, l.reps]);
						});
						var csv = rows
							.map(function (r) {
								return r.join(",");
							})
							.join("\n");
						var blob = new Blob(["\ufeff" + csv], { type: "text/csv;charset=utf-8" });
						var a = document.createElement("a");
						a.href = URL.createObjectURL(blob);
						a.download = "fitness-log.csv";
						a.click();
					});
				}
			}

			if (document.readyState === "loading") {
				document.addEventListener("DOMContentLoaded", init);
			} else {
				init();
			}
		})();
	</script>
</MainGridLayout>
