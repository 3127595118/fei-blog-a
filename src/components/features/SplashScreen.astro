---
import { profileConfig } from "@/config";

const avatar = profileConfig.avatar || "/img/avatar.svg";
---

<div id="fei-splash">
	<div class="fei-splash-bg">
		<div class="fei-splash-img" style={`background-image:url(${avatar})`}></div>
		<div class="fei-splash-dot"></div>
	</div>
</div>

<style is:global>
	html.fei-splash-active {
		overflow: hidden;
	}

	#fei-splash {
		position: fixed;
		inset: 0;
		z-index: 99999;
		display: flex;
		pointer-events: auto;
	}

	#fei-splash .fei-splash-bg {
		display: flex;
		align-items: center;
		justify-content: center;
		position: relative;
		width: 100%;
		height: 100%;
		background: rgba(255, 240, 230, 0.92);
		transition: opacity 0.3s;
	}

	html.dark #fei-splash .fei-splash-bg {
		background: rgba(25, 25, 25, 0.92);
	}

	#fei-splash .fei-splash-img {
		width: 100px;
		height: 100px;
		border-radius: 50%;
		margin: auto;
		border: 4px solid #f0f0f2;
		background-position: center center;
		background-repeat: no-repeat;
		background-size: cover;
		animation: fei-splash-loading 0.3s infinite alternate;
	}

	html.dark #fei-splash .fei-splash-img {
		border-color: rgba(255, 255, 255, 0.18);
	}

	#fei-splash .fei-splash-dot {
		width: 30px;
		height: 30px;
		background: #6bdf8f;
		position: absolute;
		border-radius: 50%;
		border: 6px solid #fff;
		top: 50%;
		left: 50%;
		transform: translate(18px, 24px);
	}

	#fei-splash.is-done {
		pointer-events: none;
	}

	#fei-splash.is-done .fei-splash-bg {
		opacity: 0;
	}

	@keyframes fei-splash-loading {
		0% {
			opacity: 1;
		}
		100% {
			opacity: 0.4;
		}
	}

	@media (max-width: 640px) {
		#fei-splash .fei-splash-img {
			width: 80px;
			height: 80px;
		}
		#fei-splash .fei-splash-dot {
			width: 24px;
			height: 24px;
			border-width: 5px;
			transform: translate(14px, 18px);
		}
	}
</style>

<script is:inline>
	(function () {
		var el = document.getElementById("fei-splash");
		if (!el) return;
		var min = 900;
		var start = Date.now();
		var done = false;
		document.documentElement.classList.add("fei-splash-active");

		function finish() {
			if (done) return;
			done = true;
			var wait = Math.max(0, min - (Date.now() - start));
			setTimeout(function () {
				el.classList.add("is-done");
				document.documentElement.classList.remove("fei-splash-active");
				setTimeout(function () {
					if (el.parentNode) el.parentNode.removeChild(el);
				}, 350);
			}, wait);
		}

		if (document.readyState === "complete") finish();
		else window.addEventListener("load", finish);
		el.addEventListener("click", finish);
		setTimeout(finish, 6000);
	})();
	</script>
